APP_NAME=NeoClip AI
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Absolute paths: the app must behave the same no matter which cwd starts uvicorn.
DATABASE_URL=sqlite:///D:/bay/PERSONAL/neoclip-ai/storage/neoclip.db
STORAGE_DIR=D:/bay/PERSONAL/neoclip-ai/storage

# 9Router. Bisa juga diisi dari UI Settings; nilai di storage/ai_config.json
# menang atas .env, dan .env hanya dipakai sebagai fallback/bootstrap.
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=
AI_MODEL=
# Chat completions timeout in seconds. Local/free models can take minutes;
# 60s surfaced as an empty "Cannot reach AI endpoint" error.
AI_TIMEOUT_SEC=300

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=1
WHISPER_DOWNLOAD_ROOT=D:/bay/PERSONAL/neoclip-ai/storage/models

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_ENCODER=libx264
# Upload guard rails. Size is enforced while streaming; duration is checked after ffprobe
# (0 = unlimited). Default 4 GB is enough for ~2 hours of 4 Mbps footage.
MAX_UPLOAD_MB=4096
MAX_DURATION_SEC=0
MAX_CONCURRENT_JOBS=1
